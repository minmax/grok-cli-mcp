{
	"name": "grok-code-mcp",
	"publishConfig": {
		"access": "public"
	},
	"version": "0.1.0",
	"description": "MCP server that delegates coding tasks to your locally installed Grok Build CLI. Wraps the real grok binary instead of bundling its own copy of the agent, so it inherits your auth, models and MCP servers. Sessions survive restarts, calls are cancellable, and each run reports tools used and tokens.",
	"type": "module",
	"bin": {
		"grok-cli-mcp": "dist/index.js"
	},
	"main": "dist/index.js",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
		"clean": "rm -rf dist",
		"prepare": "npm run build",
		"hooks": "git config core.hooksPath .githooks",
		"check": "npm run check:format && npm run check:types && npm test",
		"check:format": "biome check .",
		"check:types": "tsc --noEmit -p tsconfig.json",
		"fix": "biome check --write .",
		"test": "vitest run --typecheck",
		"test:live": "GROK_CLI_MCP_LIVE=1 vitest run --config ./vitest.config.ts test/live.test.ts",
		"test:watch": "vitest --typecheck",
		"prepublishOnly": "npm run clean && npm run build && npm run check"
	},
	"engines": {
		"node": ">=22"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"grok",
		"grok-build",
		"xai",
		"coding-agent",
		"subagent",
		"claude-code",
		"delegation"
	],
	"author": "Karataev Pavel (https://github.com/minmax)",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@types/node": "^24.0.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/minmax/grok-cli-mcp.git"
	},
	"homepage": "https://github.com/minmax/grok-cli-mcp#readme",
	"bugs": "https://github.com/minmax/grok-cli-mcp/issues"
}
